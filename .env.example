# Add only public Supabase URL and publishable key to browser-facing variables.
NEXT_PUBLIC_SUPABASE_URL=https://ijikaqxgsfsakdtzzgkc.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# A project-specific publishable-key development fallback is built in (safe for browsers).\n# Server only (later phases): do not prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=worksheet-files
# LINE Messaging API - server-only admin alerts\nLINE_CHANNEL_ACCESS_TOKEN=\nLINE_ADMIN_USER_ID=\n# Supabase user registration database webhook shared secret\nWORKSHEET_WEBHOOK_SECRET=\n\n# Set to your production host when ready for canonical URLs
NEXT_PUBLIC_SITE_URL=https://worksheet-tau-six.vercel.app

# Keep disabled on a preview or until legal, content and domain launch are ready.
ENABLE_SEARCH_INDEXING=false

# Optional Google Search Console URL-prefix verification token, after property setup.
GOOGLE_SITE_VERIFICATION=

# Enable only after testing original template generation and private R2 delivery.
CRON_SECRET=
AUTO_GENERATION_ENABLED=false

# Worksheet AI generator (all private server-side; do not use NEXT_PUBLIC_)
CGU_API_KEY=
CGU_LOCAL_MODEL=gpt-oss:20b
CGU_COMPAT_MODEL=gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

# CGU LLM Gateway supports image models through the existing CGU_API_KEY.
# Verify your account's model list and OpenAI USD quota at https://air.cgu.edu.tw/workspace4/LLMAPI/index.php
# No separate image key is needed when CGU_API_KEY is configured.
CGU_IMAGE_MODEL=chatgpt-image-latest

# Optional direct provider, used only if CGU_API_KEY is unset.
# Never prefix any server key with NEXT_PUBLIC_.
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
